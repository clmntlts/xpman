# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
build/
dist/

# Local data — never shared, never committed
data/*.db
data/*.db-*
data/*.db.bak
data/runs/
# Stray per-run exports written next to the DB during manual/dev launches
data/run_*_results.csv
# Raw-data export bundle (core.raw_export.export_run_raw_bundle / GUI's "Export Raw Data...")
data/run_*_events.csv
data/run_*_events.parquet
data/run_*_manifest.json
# Auditory-timing calibration outputs + per-machine audio profiles (machine-specific, not shared)
data/audio_calibration/
data/audio_profiles/

# Editors
.vscode/
.idea/

# PyInstaller -- xpman.spec is regenerated fresh by scripts/build_windows_exe.ps1 every run
*.spec
*.spec.bak

# Inno Setup installer output -- regenerated by scripts/build_installer.ps1, not source
installer/output/

# Test-generated screenshots (regenerated by tests/unit/gui/*, not source)
tests/unit/gui/*.png

# Local Claude Code workflow file -- kept on disk for the assistant, not published to the repo
CLAUDE.md

# Vendored Plotly for the integration verifier -- fetched by
# scripts/build_integration_verifier_exe.ps1 (or downloaded on demand), not source
src/xpman/verification/assets/plotly.min.js
